html
    head
        title Users
        link(rel="stylesheet", href="/css/styles.css")
    body
    div.container
        div.main-chat-area
            div.header
                h2 All Users
                a(href="/frontpage") Back to Frontpage

            div.user-list
                ul
                    each user in users
                        li
                            a(href="#", onclick=`showUserDetails(${user.userID})`) #{user.username} (ID: #{user.userID})

            div#user-details(style="display: none;")
                h3 User Details
                div#details-content

    script.
        async function showUserDetails(userID) {
            try {
                const response = await fetch(`/api/users/${userID}`);
                const data = await response.json();
                if (data.error) {
                    alert(data.error);
                    return;
                }
                const detailsDiv = document.getElementById('details-content');
                detailsDiv.innerHTML = `
                    <p><strong>Username:</strong> ${data.user.username}</p>
                    <p><strong>User ID:</strong> ${data.user.userID}</p>
                    <h4>Chats:</h4>
                    <ul>
                        ${data.userChats.map(chat => `<li>${chat.name} (ID: ${chat.chatID})</li>`).join('')}
                    </ul>
                `;
                document.getElementById('user-details').style.display = 'block';
            } catch (error) {
                console.error('Error fetching user details:', error);
                alert('Error loading user details');
            }
        }